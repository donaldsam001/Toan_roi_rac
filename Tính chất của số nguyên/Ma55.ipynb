   "source": [
    "def factorint(n):\n",
    "    i = 2\n",
    "    f = {}\n",
    "    while n >1:\n",
    "        while n % i != 0:\n",
    "            i+= 1\n",
    "        e = 0\n",
    "        while n % i == 0:\n",
    "            n //= i\n",
    "            e += 1\n",
    "            f[i] = e\n",
    "    return f"
   ]
