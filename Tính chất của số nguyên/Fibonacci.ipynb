   "source": [
    "def Fibonacci(n):\n",
    "    if n<=0:\n",
    "        return 0\n",
    "    if n==1:\n",
    "        return 1\n",
    "    return Fibonacci(n-1) + Fibonacci(n-2)"
   ]
